# cp .env.example .env
# Clé que tes clients (Cursor, curl…) envoient en Bearer — pas OpenAI, pas ChatGPT.
OPENAI_COMPAT_API_KEY=remplacer-par-un-secret-long

# Le port 8001 publie la passerelle (corrige l'historique assistant) → codex_openai_server en interne.
# Les modèles disponibles sont détectés automatiquement au démarrage.

# Optionnel (déjà fixés dans docker-compose pour écoute LAN)
# OPENAI_COMPAT_HOST=0.0.0.0
# OPENAI_COMPAT_PORT=8001

# Intervalle de rafraîchissement du cache des modèles (secondes, défaut 300 = 5 min)
# MODEL_REFRESH_SECONDS=300

OPENAI_COMPAT_LOG_LEVEL=INFO
OPENAI_COMPAT_LOG_FORMAT=text
OPENAI_COMPAT_DEBUG_LOGGING=false
OPENAI_COMPAT_LOG_PAYLOADS=false
